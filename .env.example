# ============================================================
# Application - Exemplo de variáveis de ambiente
# Copie para .env e preencha os valores reais.
# O arquivo .env está no .gitignore e NUNCA deve ser commitado.
# ============================================================

# --- Banco de dados PostgreSQL ---
DATABASE_URL=postgresql://svc_application:SUA_SENHA@localhost:5432/application_db

# --- Template do CV gerado (harvard | corporate) ---
# harvard   = layout denso, single-column, otimizado para ATS (padrão)
# corporate = layout com faixa de cor no topo (versão legada)
CV_TEMPLATE=harvard

# --- Cérebro IA: roteador local de LLMs livres (FreeLLM-router / freellmapi) ---
# Quando LLM_BASE_URL e LLM_API_KEY estão preenchidos, esta é a via preferencial.
# O gateway roda em Docker: http://127.0.0.1:3001/v1 (chave unificada em
# FreeLLM-router/.unified-key). Reaproveitável por qualquer projeto.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=auto

# --- Cérebro IA (Azure OpenAI) - fallback opcional ---
# Usado apenas quando LLM_BASE_URL/LLM_API_KEY não estão configurados.
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# --- Human-in-the-Loop (Telegram) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Notificações por e-mail (AgentMail) ---
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=menond@agentmail.to

# --- Credenciais do LinkedIn (usadas pelo playwright_bot.py) ---
LINKEDIN_USERNAME=
LINKEDIN_PASSWORD=
LINKEDIN_PHONE_NUMBER=

# --- Scheduler do crawler (horas entre execuções no modo --loop) ---
CRAWLER_INTERVAL_HOURS=4

# --- Crawler multi-fonte ---
# Fontes habilitadas (sobrepõe o campo "enabled" de config/sources.yaml).
# Opções implementadas: remotive, wwr, workingnomads, linkedin
CRAWLER_SOURCES=remotive,wwr,workingnomads
# Caminho alternativo para o catálogo de fontes
# CRAWLER_CONFIG=/caminho/para/sources.yaml
SEARCH_KEYWORDS=product manager,product owner,project manager,gerente de projetos,gerente de produtos
SEARCH_LOCATIONS=Brazil,Remote,LATAM,Worldwide
CRAWLER_LIMIT_PER_SOURCE=50

# --- Preferências de busca de vagas ---
LINKEDIN_POSITIONS=
LINKEDIN_LOCATIONS=
LINKEDIN_SALARY=60,000
