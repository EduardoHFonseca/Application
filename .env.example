# ============================================================
# Application - Exemplo de variáveis de ambiente
# Copie para .env e preencha os valores reais.
# O arquivo .env está no .gitignore e NUNCA deve ser commitado.
# ============================================================

# --- Banco de dados PostgreSQL ---
DATABASE_URL=postgresql://svc_application:SUA_SENHA@localhost:5432/application_db

# --- Template do CV gerado (harvard | corporate) ---
# harvard   = layout denso, single-column, otimizado para ATS (padrão)
# corporate = layout com faixa de cor no topo (versão legada)
CV_TEMPLATE=harvard

# --- Cérebro IA (Azure OpenAI) ---
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# --- Human-in-the-Loop (Telegram) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Notificações por e-mail (AgentMail) ---
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=menond@agentmail.to

# --- Credenciais do LinkedIn (usadas pelo playwright_bot.py) ---
LINKEDIN_USERNAME=
LINKEDIN_PASSWORD=
LINKEDIN_PHONE_NUMBER=

# --- Scheduler do crawler (horas entre execuções no modo --loop) ---
CRAWLER_INTERVAL_HOURS=4

# --- Preferências de busca de vagas ---
LINKEDIN_POSITIONS=
LINKEDIN_LOCATIONS=
LINKEDIN_SALARY=60,000
